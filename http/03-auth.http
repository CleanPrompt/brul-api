### TEST 1 — Geldige login
# Verwacht: 200 OK
# Response bevat accessToken, refreshToken, tokenType en expiresIn.

POST http://127.0.0.1:8080/api/v1/auth/login
Content-Type: application/json

{
  "email": "http-test-01@brul.nl",
  "password": "Welkom123!"
}


### TEST 2 — Login met hoofdletters en spaties in e-mail
# Verwacht: 200 OK

POST http://127.0.0.1:8080/api/v1/auth/login
Content-Type: application/json

{
  "email": "  HTTP-TEST-01@BRUL.NL  ",
  "password": "Welkom123!"
}


### TEST 3 — Verkeerd wachtwoord
# Verwacht: 401 Unauthorized
# Foutcode: INVALID_CREDENTIALS

POST http://127.0.0.1:8080/api/v1/auth/login
Content-Type: application/json

{
  "email": "http-test-01@brul.nl",
  "password": "Verkeerd123!"
}


### TEST 4 — Onbekend e-mailadres
# Verwacht: 401 Unauthorized
# Foutcode: INVALID_CREDENTIALS

POST http://127.0.0.1:8080/api/v1/auth/login
Content-Type: application/json

{
  "email": "bestaat-niet@brul.nl",
  "password": "Welkom123!"
}


### TEST 5 — Leeg wachtwoord
# Verwacht: 400 Bad Request

POST http://127.0.0.1:8080/api/v1/auth/login
Content-Type: application/json

{
  "email": "http-test-01@brul.nl",
  "password": ""
}


### TEST 6 — Nieuw access token aanvragen
# Verwacht: 200 OK
# Kopieer het refreshToken uit TEST 1.
# De response bevat GEEN nieuw refreshToken.

POST http://127.0.0.1:8080/api/v1/auth/refresh
Content-Type: application/json

{
  "refreshToken": "g7QFrVH0f-HHVjfC8urhAH3nd7a9Okf9blPB7X7uZlE"
}


### TEST 7 — Ongeldig refresh token
# Verwacht: 401 Unauthorized
# Foutcode: INVALID_REFRESH_TOKEN

POST http://127.0.0.1:8080/api/v1/auth/refresh
Content-Type: application/json

{
  "refreshToken": "dit-is-geen-geldig-refresh-token"
}


### TEST 8 — Leeg refresh token
# Verwacht: 400 Bad Request
# Foutcode: VALIDATION_ERROR

POST http://127.0.0.1:8080/api/v1/auth/refresh
Content-Type: application/json

{
  "refreshToken": ""
}


### TEST 9 — Alleen spaties als refresh token
# Verwacht: 400 Bad Request

POST http://127.0.0.1:8080/api/v1/auth/refresh
Content-Type: application/json

{
  "refreshToken": "   "
}


### TEST 10 — Logout met geldig refresh token
# Verwacht: 204 No Content
# Gebruik hetzelfde refresh token als in TEST 6.
# Voer TEST 6 eerst uit!

POST http://127.0.0.1:8080/api/v1/auth/logout
Content-Type: application/json

{
  "refreshToken": "g7QFrVH0f-HHVjfC8urhAH3nd7a9Okf9blPB7X7uZlE"
}


### TEST 11 — Refresh na logout
# Verwacht: 401 Unauthorized
# Foutcode: INVALID_REFRESH_TOKEN
# Gebruik hetzelfde token als in TEST 10.

POST http://127.0.0.1:8080/api/v1/auth/refresh
Content-Type: application/json

{
  "refreshToken": "g7QFrVH0f-HHVjfC8urhAH3nd7a9Okf9blPB7X7uZlE"
}


### TEST 12 — Tweede logout met hetzelfde token
# Verwacht: 401 Unauthorized
# Foutcode: INVALID_REFRESH_TOKEN

POST http://127.0.0.1:8080/api/v1/auth/logout
Content-Type: application/json

{
  "refreshToken": "g7QFrVH0f-HHVjfC8urhAH3nd7a9Okf9blPB7X7uZlE"
}


### TEST 13 — Logout met onbekend token
# Verwacht: 401 Unauthorized

POST http://127.0.0.1:8080/api/v1/auth/logout
Content-Type: application/json

{
  "refreshToken": "onbekend-refresh-token"
}


### TEST 14 — Logout met leeg token
# Verwacht: 400 Bad Request

POST http://127.0.0.1:8080/api/v1/auth/logout
Content-Type: application/json

{
  "refreshToken": ""
}