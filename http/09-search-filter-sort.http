### 14 - Filteren op SAFETY
GET {{baseUrl}}/reports?type=SAFETY

> {%
    client.test("Typefilter SAFETY", function() {
        client.assert(response.status === 200);
        client.assert(response.body.length >= 2);

        client.assert(response.body.every(function(item) {
            return item.type === "SAFETY";
        }));
    });
%}

### 15 - Filteren op HELP_REQUEST
GET {{baseUrl}}/reports?type=HELP_REQUEST

> {%
    client.test("Typefilter HELP_REQUEST", function() {
        client.assert(response.status === 200);

        client.assert(response.body.every(function(item) {
            return item.type === "HELP_REQUEST";
        }));

        client.assert(response.body.some(function(item) {
            return item.id === Number(client.global.get("searchReportC"));
        }));
    });
%}

### 16 - Filteren op categorie NOISE
GET {{baseUrl}}/reports?category=NOISE

> {%
    client.test("Categoriefilter NOISE", function() {
        client.assert(response.status === 200);

        client.assert(response.body.every(function(item) {
            return item.category === "NOISE";
        }));

        client.assert(response.body.some(function(item) {
            return item.id === Number(client.global.get("searchReportB"));
        }));
    });
%}

### 17 - Type en categorie combineren
GET {{baseUrl}}/reports?type=SAFETY&category=THEFT

> {%
    client.test("Gecombineerd filter werkt", function() {
        client.assert(response.status === 200);

        client.assert(response.body.every(function(item) {
            return item.type === "SAFETY" &&
                item.category === "THEFT";
        }));

        client.assert(response.body.some(function(item) {
            return item.id === Number(client.global.get("searchReportA"));
        }));
    });
%}

