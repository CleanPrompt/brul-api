
# http/09-search-filter-sort.http

@baseUrl = http://127.0.0.1:8080/api/v1

### 01 - Inloggen als eigenaar
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "http-test-01@brul.nl",
  "password": "Welkom123!"
}

> {%
    client.test("Inloggen werkt", function() {
        client.assert(response.status === 200);
    });

    if (response.status === 200) {
        client.global.set("searchOwnerToken", response.body.accessToken);
    }
%}

### 02 - Inloggen als stemmer
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "http-vote-test@brul.nl",
  "password": "Welkom123!"
}

> {%
    client.test("Stemmer ingelogd", function() {
        client.assert(response.status === 200);
    });

    if (response.status === 200) {
        client.global.set("searchVoterToken", response.body.accessToken);
    }
%}

### 03 - Melding A: dichtbij, SAFETY
POST {{baseUrl}}/reports
Authorization: Bearer {{searchOwnerToken}}
Content-Type: application/json

{
  "type": "SAFETY",
  "category": "THEFT",
  "title": "Zoektest unieke fiets gestolen",
  "description": "Een blauwe fiets is verdwenen bij de fietsenstalling.",
  "latitude": 52.001,
  "longitude": 4.213
}

> {%
    client.test("Melding A aangemaakt", function() {
        client.assert(response.status === 201);
    });

    if (response.status === 201) {
        client.global.set("searchReportA", response.body.id);
    }
%}

