### 21 - Sorteren op nieuwste
GET {{baseUrl}}/reports?sort=newest

> {%
    client.test("Nieuwste eerst", function() {
        client.assert(response.status === 200);

        for (var i = 1; i < response.body.length; i++) {
            var previous = response.body[i - 1];
            var current = response.body[i];

            client.assert(
                Date.parse(previous.createdAt) >=
                Date.parse(current.createdAt)
            );
        }
    });
%}

### 22 - Sorteren op meeste likes
GET {{baseUrl}}/reports?sort=mostLiked

> {%
    client.test("Meeste likes eerst", function() {
        client.assert(response.status === 200);

        for (var i = 1; i < response.body.length; i++) {
            client.assert(
                response.body[i - 1].likeCount >=
                response.body[i].likeCount
            );
        }
    });
%}

### 23 - Sorteren op meeste weergaven
GET {{baseUrl}}/reports?sort=mostViewed

> {%
    client.test("Meeste weergaven eerst", function() {
        client.assert(response.status === 200);

        for (var i = 1; i < response.body.length; i++) {
            client.assert(
                response.body[i - 1].viewCount >=
                response.body[i].viewCount
            );
        }
    });
%}

### 24 - Geografisch zoeken binnen 5 kilometer
GET {{baseUrl}}/reports?latitude=52.001&longitude=4.213&radiusKm=5

> {%
    client.test("Radiusfilter van 5 km werkt", function() {
        client.assert(response.status === 200);

        client.assert(response.body.every(function(item) {
            return item.distanceKm !== null &&
                item.distanceKm <= 5;
        }));

        var ids = response.body.map(function(item) {
            return item.id;
        });

        client.assert(ids.includes(Number(client.global.get("searchReportA"))));
        client.assert(ids.includes(Number(client.global.get("searchReportB"))));
        client.assert(ids.includes(Number(client.global.get("searchReportD"))));
        client.assert(!ids.includes(Number(client.global.get("searchReportC"))));
    });
%}

### 25 - Sorteren op afstand
GET {{baseUrl}}/reports?latitude=52.001&longitude=4.213&sort=nearest

> {%
    client.test("Dichtstbijzijnde meldingen eerst", function() {
        client.assert(response.status === 200);

        for (var i = 1; i < response.body.length; i++) {
            client.assert(
                response.body[i - 1].distanceKm <=
                response.body[i].distanceKm
            );
        }
    });
%}

### 26 - Exact dezelfde locatie geeft afstand nul
GET {{baseUrl}}/reports?type=SAFETY&category=THEFT&latitude=52.001&longitude=4.213&sort=nearest

> {%
    client.test("Afstand tot eigen locatie is nul", function() {
        client.assert(response.status === 200);

        var report = response.body.find(function(item) {
            return item.id === Number(client.global.get("searchReportA"));
        });

        client.assert(report !== undefined);
        client.assert(Math.abs(report.distanceKm) < 0.001);
    });
%}

### 27 - Afstand ongeveer één kilometer
GET {{baseUrl}}/reports?q=zoektest&latitude=52.001&longitude=4.213&sort=nearest

> {%
    client.test("Haversine-afstand is ongeveer correct", function() {
        client.assert(response.status === 200);

        var report = response.body.find(function(item) {
            return item.id === Number(client.global.get("searchReportB"));
        });

        client.assert(report !== undefined);
        client.assert(report.distanceKm > 0.9);
        client.assert(report.distanceKm < 1.1);
    });
%}

### 28 - Gecombineerd zoeken, filteren en afstand
GET {{baseUrl}}/reports?type=SAFETY&latitude=52.001&longitude=4.213&radiusKm=5&sort=nearest

> {%
    client.test("Gecombineerde filters werken", function() {
        client.assert(response.status === 200);

        client.assert(response.body.every(function(item) {
            return item.type === "SAFETY" &&
                item.distanceKm <= 5;
        }));

        for (var i = 1; i < response.body.length; i++) {
            client.assert(
                response.body[i - 1].distanceKm <=
                response.body[i].distanceKm
            );
        }
    });
%}

