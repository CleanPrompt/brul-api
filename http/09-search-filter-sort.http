### 45 - Alle resultaten blijven geldig
GET {{baseUrl}}/reports?sort=newest

> {%
    client.test("Resultaten hebben de juiste velden", function() {
        client.assert(response.status === 200);

        response.body.forEach(function(item) {
            client.assert(typeof item.id === "number");
            client.assert(typeof item.title === "string");
            client.assert(typeof item.type === "string");
            client.assert(typeof item.category === "string");
            client.assert(typeof item.viewCount === "number");
            client.assert(typeof item.likeCount === "number");
            client.assert(typeof item.dislikeCount === "number");
            client.assert(typeof item.createdAt === "string");
        });
    });
%}
