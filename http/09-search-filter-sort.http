### 07 - LIKE plaatsen op melding B
PUT {{baseUrl}}/reports/{{searchReportB}}/vote
Authorization: Bearer {{searchVoterToken}}
Content-Type: application/json

{
  "value": "LIKE"
}

> {%
    client.test("LIKE op B geplaatst", function() {
        client.assert(response.status === 200);
        client.assert(response.body.likeCount === 1);
    });
%}

### 08 - Extra weergave voor melding A
GET {{baseUrl}}/reports/{{searchReportA}}

> {%
    client.test("Detail A werkt", function() {
        client.assert(response.status === 200);
        client.assert(response.body.viewCount >= 1);
    });
%}

### 09 - Nog een weergave voor melding A
GET {{baseUrl}}/reports/{{searchReportA}}

> {%
    client.test("ViewCount wordt verhoogd", function() {
        client.assert(response.status === 200);
        client.assert(response.body.viewCount >= 2);
    });
%}

### 10 - Alle meldingen ophalen
GET {{baseUrl}}/reports

> {%
    client.test("Alle meldingen worden opgehaald", function() {
        client.assert(response.status === 200);
        client.assert(Array.isArray(response.body));

        var ids = response.body.map(function(item) {
            return item.id;
        });

        client.assert(ids.includes(Number(client.global.get("searchReportA"))));
        client.assert(ids.includes(Number(client.global.get("searchReportB"))));
        client.assert(ids.includes(Number(client.global.get("searchReportC"))));
        client.assert(ids.includes(Number(client.global.get("searchReportD"))));
    });
%}

### 11 - Zoeken op titel
GET {{baseUrl}}/reports?q=verkeerssituatie

> {%
    client.test("Zoeken op titel werkt", function() {
        client.assert(response.status === 200);

        var found = response.body.some(function(item) {
            return item.id === Number(client.global.get("searchReportD"));
        });

        client.assert(found);
    });
%}

