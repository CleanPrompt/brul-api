# http/05-reports.http

@baseUrl = http://127.0.0.1:8080/api/v1

### 01 - Inloggen om een access token te krijgen
# Gebruik een account dat je eerder hebt geregistreerd.
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "http-test-01@brul.nl",
  "password": "Welkom123!"
}

> {%
    client.test("Login geeft 200", function() {
        client.assert(response.status === 200);
    });

    if (response.status === 200) {
        client.global.set("accessToken", response.body.accessToken);
    }
%}

### 02 - Geldige veiligheidsmelding aanmaken
POST {{baseUrl}}/reports
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "type": "SAFETY",
  "category": "THEFT",
  "title": "Fiets gestolen",
  "description": "Mijn fiets is gisteren bij het station gestolen.",
  "latitude": 52.001,
  "longitude": 4.213
}

> {%
    client.test("Veiligheidsmelding geeft 201", function() {
        client.assert(response.status === 201);
    });

    client.test("Nieuwe melding heeft geen weergaven", function() {
        client.assert(response.body.viewCount === 0);
    });

    client.test("Geen capaciteit bij veiligheidsmelding", function() {
        client.assert(response.body.maxHelpers === null);
    });
%}

### 03 - Geldige overlastmelding aanmaken
POST {{baseUrl}}/reports
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "type": "NUISANCE",
  "category": "NOISE",
  "title": "Geluidsoverlast",
  "description": "Er is regelmatig harde muziek tot laat in de nacht.",
  "latitude": 52.002,
  "longitude": 4.214,
  "imageUrl": null
}

> {%
    client.test("Overlastmelding geeft 201", function() {
        client.assert(response.status === 201);
    });
%}

### 04 - Geldige hulpvraag aanmaken
POST {{baseUrl}}/reports
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "type": "HELP_REQUEST",
  "category": "GROCERIES",
  "title": "Hulp bij boodschappen",
  "description": "Ik zoek twee bewoners die boodschappen kunnen ophalen.",
  "latitude": 52.001,
  "longitude": 4.213,
  "imageUrl": null,
  "maxHelpers": 2
}

> {%
    client.test("Hulpvraag geeft 201", function() {
        client.assert(response.status === 201);
    });

    client.test("Nieuwe hulpvraag is OPEN", function() {
        client.assert(response.body.status === "OPEN");
    });

    client.test("Capaciteit is twee", function() {
        client.assert(response.body.maxHelpers === 2);
    });

    client.test("Er zijn nog geen deelnemers", function() {
        client.assert(response.body.participantCount === 0);
    });
%}

### 05 - Geen token: 401
POST {{baseUrl}}/reports
Content-Type: application/json

{
  "type": "SAFETY",
  "category": "THEFT",
  "title": "Fiets gestolen",
  "description": "Mijn fiets is gisteren bij het station gestolen.",
  "latitude": 52.001,
  "longitude": 4.213
}

> {%
    client.test("Zonder token geeft 401", function() {
        client.assert(response.status === 401);
    });
%}

### 06 - Verkeerde categorie: 400
POST {{baseUrl}}/reports
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "type": "SAFETY",
  "category": "GROCERIES",
  "title": "Verkeerde categorie",
  "description": "Deze categorie hoort niet bij een veiligheidsmelding.",
  "latitude": 52.001,
  "longitude": 4.213
}

> {%
    client.test("Verkeerde categorie geeft 400", function() {
        client.assert(response.status === 400);
        client.assert(response.body.code === "VALIDATION_ERROR");
    });
%}

